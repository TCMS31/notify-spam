# Copy to .env for local development. Every variable is optional in development:
# with none set the app still ingests webhooks and logs the alert instead of
# sending it.

# --- Slack -----------------------------------------------------------------
# Bot token with chat:write, and the channel to post into (name or channel id).
SLACK_API_TOKEN=
SLACK_CHANNEL_NAME=

# Which notification channel to use: slack (default) or null (log only).
NOTIFIER=slack

# --- Webhook authentication -------------------------------------------------
# Shared secret the provider sends as HTTP Basic credentials. Leave unset to
# keep the endpoint open locally; production refuses to boot without them
# unless ALLOW_UNAUTHENTICATED_WEBHOOK=true.
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=

# --- Behaviour --------------------------------------------------------------
# Provider type code that marks a spam complaint. Postmark uses 512.
SPAM_TYPE_CODE=512

# Active Job backend. The default :async adapter is in-process and loses queued
# work on restart; use a durable adapter in production.
ACTIVE_JOB_ADAPTER=async

# Comma-separated browser origins allowed to call the API. Empty disables CORS
# entirely, which is correct for a server-to-server webhook.
CORS_ORIGINS=
